<mujoco model="largebox">

    <compiler meshdir="./"/>

    <default>
        <geom friction="0.9 0.5 0.5"
              rgba="0.7 0.8 0.9 0.7"/>
        <joint damping="0.5"/>
    </default>

    <asset>
        <mesh name="largebox_mesh"
              file="largebox.obj"
              scale="1 1 1"/>
    </asset>

    <worldbody>

        <body name="largebox_link"
              pos="0 0 0.5">

            <!-- 自由物体 -->
            <freejoint/>

            <inertial pos="0 0 0"
                      mass="0.1"
                      diaginertia="0.002 0.002 0.002"/>

            <!-- 物块 -->
            <geom type="mesh"
                  mesh="largebox_mesh"
                  pos="0 0 0"
                  quat="1 0 0 0"
                  rgba="0.7 0.8 0.9 0.0"
                  friction="0.9 0.5 0.5"
                  solref="0.02 1"
                  solimp="0.9 0.95 0.001"/>

            <!-- X轴 红色 -->
            <geom type="capsule"
                  fromto="0 0 0   0.2 0 0"
                  size="0.01"
                  rgba="1 0 0 1"
                  contype="0"
                  conaffinity="0"/>

            <!-- Y轴 蓝色 -->
            <geom type="capsule"
                  fromto="0 0 0   0 0.2 0"
                  size="0.01"
                  rgba="0 0 1 1"
                  contype="0"
                  conaffinity="0"/>

            <!-- Z轴 绿色 -->
            <geom type="capsule"
                  fromto="0 0 0   0 0 0.2"
                  size="0.01"
                  rgba="0 1 0 1"
                  contype="0"
                  conaffinity="0"/>

        </body>

    </worldbody>

</mujoco>